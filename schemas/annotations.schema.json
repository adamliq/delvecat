{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://delvecat.dev/schemas/annotations.schema.json",
  "title": "AnnotationFile",
  "description": "A file in annotations/: human-curated metadata merged into catalog bundles.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "annotations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Entry"
      }
    },
    "glossary": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Term"
      }
    },
    "classifications": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ClassificationDef"
      }
    },
    "domains": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Domain"
      }
    },
    "dataProducts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/DataProduct"
      }
    }
  },
  "$defs": {
    "StringList": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "Entry": {
      "type": "object",
      "additionalProperties": false,
      "description": "Applies to one entity (id) or to every entity matching a selector (match).",
      "oneOf": [
        {
          "required": [
            "id"
          ]
        },
        {
          "required": [
            "match"
          ]
        }
      ],
      "properties": {
        "id": {
          "description": "Exact entity id, e.g. acme:index:web",
          "type": "string",
          "minLength": 1
        },
        "match": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "description": "All given keys must match. name and app accept * and ? wildcards.",
          "properties": {
            "type": {
              "type": "string"
            },
            "product": {
              "type": "string"
            },
            "instance": {
              "type": "string"
            },
            "app": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "owner": {
              "type": "string"
            }
          }
        },
        "description": {
          "type": "string"
        },
        "owners": {
          "$ref": "#/$defs/StringList"
        },
        "tags": {
          "$ref": "#/$defs/StringList"
        },
        "classifications": {
          "$ref": "#/$defs/StringList"
        },
        "glossaryTerms": {
          "$ref": "#/$defs/StringList"
        },
        "links": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "url"
            ],
            "properties": {
              "title": {
                "type": "string"
              },
              "url": {
                "type": "string",
                "format": "uri",
                "pattern": "^https?://"
              }
            }
          }
        },
        "domain": {
          "description": "The business domain this object belongs to (one per object).",
          "type": "string",
          "minLength": 1
        }
      }
    },
    "Term": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "term"
      ],
      "properties": {
        "term": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "synonyms": {
          "$ref": "#/$defs/StringList"
        },
        "related": {
          "$ref": "#/$defs/StringList"
        }
      }
    },
    "ClassificationDef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "description": "A classification in the taxonomy. 'PII' also covers 'PII.Email' unless that is defined itself.",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "sensitive": {
          "type": "boolean",
          "description": "Counts for 'who can see sensitive data' (default true)."
        },
        "propagate": {
          "type": "boolean",
          "description": "Carry to data derived from it (default true)."
        }
      }
    },
    "Domain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "owners": {
          "$ref": "#/$defs/StringList"
        },
        "parent": {
          "type": "string",
          "description": "Parent domain, for sub-domains."
        },
        "links": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "url"
            ],
            "properties": {
              "title": {
                "type": "string"
              },
              "url": {
                "type": "string",
                "pattern": "^https?://"
              }
            }
          }
        }
      }
    },
    "AssetSpec": {
      "type": "object",
      "additionalProperties": false,
      "oneOf": [
        {
          "required": [
            "id"
          ]
        },
        {
          "required": [
            "match"
          ]
        }
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "match": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "description": "All given keys must match. name and app accept * and ? wildcards.",
          "properties": {
            "type": {
              "type": "string"
            },
            "product": {
              "type": "string"
            },
            "instance": {
              "type": "string"
            },
            "app": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "owner": {
              "type": "string"
            }
          }
        }
      }
    },
    "DataProduct": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "assets"
      ],
      "description": "A named, owned set of assets delivered together (e.g. 'Storefront Analytics').",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "domain": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "owners": {
          "$ref": "#/$defs/StringList"
        },
        "links": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "url"
            ],
            "properties": {
              "title": {
                "type": "string"
              },
              "url": {
                "type": "string",
                "pattern": "^https?://"
              }
            }
          }
        },
        "assets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/AssetSpec"
          }
        }
      }
    }
  }
}
