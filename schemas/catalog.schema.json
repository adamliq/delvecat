{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://delvecat.dev/schemas/catalog.schema.json",
  "title": "CatalogBundle",
  "description": "A DelveCat catalog bundle: a point-in-time, read-only snapshot of Splunk metadata.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "generatedAt",
    "generator",
    "instances",
    "entities",
    "edges"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^0\\.1\\.\\d+$"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      }
    },
    "instances": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Instance"
      }
    },
    "entities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Entity"
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Edge"
      }
    },
    "ingestionReport": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ConnectorReport"
      }
    },
    "changes": {
      "$ref": "#/$defs/ChangeSummary"
    },
    "shards": {
      "description": "When present, entities and edges live in these files (paths relative to this manifest) and the entities/edges arrays here are empty.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/Shard"
      }
    },
    "glossary": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/GlossaryTerm"
      }
    },
    "annotationSource": {
      "$ref": "#/$defs/AnnotationSource"
    },
    "classifications": {
      "description": "Classification taxonomy from annotations.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/Classification"
      }
    },
    "redaction": {
      "description": "Present when the bundle was redacted for publishing.",
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "profile": {
          "type": "string"
        },
        "stablePseudonyms": {
          "type": "boolean"
        },
        "counts": {
          "type": "object",
          "additionalProperties": {
            "type": "integer"
          }
        }
      }
    },
    "references": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/OpenReference"
      }
    },
    "mergedFrom": {
      "description": "Bundles combined by `delvecat-ingest merge`.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "instances",
          "generatedAt"
        ],
        "properties": {
          "instances": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "generatedAt": {
            "type": "string"
          },
          "source": {
            "type": "string"
          }
        }
      }
    },
    "domains": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Domain"
      }
    },
    "dataProducts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/DataProduct"
      }
    }
  },
  "$defs": {
    "Product": {
      "description": "The Splunk product an entity belongs to.",
      "type": "string",
      "enum": [
        "splunk",
        "enterpriseSecurity",
        "soar",
        "ueba",
        "assetRiskIntelligence",
        "stream",
        "deploymentServer",
        "dbConnect"
      ]
    },
    "EntityType": {
      "type": "string",
      "enum": [
        "instance",
        "app",
        "user",
        "role",
        "index",
        "sourcetype",
        "source",
        "host",
        "field",
        "dataModel",
        "lookup",
        "automaticLookup",
        "kvCollection",
        "savedSearch",
        "macro",
        "eventtype",
        "tag",
        "fieldAlias",
        "calculatedField",
        "fieldExtraction",
        "transform",
        "workflowAction",
        "dashboard",
        "input",
        "forwarder",
        "correlationSearch",
        "findingType",
        "riskRule",
        "threatIntelSource",
        "assetIdentitySource",
        "adaptiveResponseAction",
        "analyticStory",
        "responseTemplate",
        "soarPlaybook",
        "soarCustomFunction",
        "soarApp",
        "soarAsset",
        "soarLabel",
        "soarWorkbook",
        "uebaDataSource",
        "uebaModel",
        "uebaAnomalyType",
        "uebaThreatRule",
        "uebaOutputConnector",
        "ariSource",
        "ariAssetType",
        "ariMetric",
        "ariExposure",
        "streamForwarder",
        "streamGroup",
        "streamDefinition",
        "serverClass",
        "deploymentApp",
        "deploymentClient",
        "dbConnection",
        "dbIdentity",
        "dbInput",
        "dbOutput",
        "dbLookup",
        "externalTable"
      ]
    },
    "Sharing": {
      "type": "string",
      "enum": [
        "user",
        "app",
        "global",
        "system"
      ]
    },
    "Instance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "kind"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+$"
        },
        "name": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "splunkEnterprise",
            "splunkCloud",
            "soar",
            "uba",
            "deploymentServer"
          ]
        },
        "version": {
          "type": "string"
        },
        "webUrl": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://"
        },
        "roles": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "properties": {
          "description": "Instance-level facts (e.g. server roles, Cloud IP allow-list counts). Never contains credentials.",
          "type": "object",
          "additionalProperties": true
        },
        "product": {
          "type": "string"
        }
      }
    },
    "Entity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "name",
        "product",
        "instance"
      ],
      "properties": {
        "id": {
          "description": "Fully qualified name, unique within the bundle.",
          "type": "string",
          "minLength": 1
        },
        "type": {
          "$ref": "#/$defs/EntityType"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "displayName": {
          "type": "string"
        },
        "product": {
          "$ref": "#/$defs/Product"
        },
        "instance": {
          "type": "string"
        },
        "app": {
          "type": "string"
        },
        "owner": {
          "type": "string"
        },
        "sharing": {
          "$ref": "#/$defs/Sharing"
        },
        "disabled": {
          "type": "boolean"
        },
        "description": {
          "type": "string"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "sourceUrl": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://"
        },
        "properties": {
          "description": "Type-specific attributes. Never contains credentials.",
          "type": "object",
          "additionalProperties": true
        },
        "version": {
          "description": "Increments when the entity's content changes between ingestion runs.",
          "type": "integer",
          "minimum": 1
        },
        "firstSeenAt": {
          "description": "When DelveCat first saw this entity.",
          "type": "string",
          "format": "date-time"
        },
        "contentHash": {
          "description": "Hash of the entity's extracted content, used to detect changes.",
          "type": "string"
        },
        "annotations": {
          "$ref": "#/$defs/Annotations"
        },
        "lineage": {
          "description": "Diagnostics from SPL analysis. Derived, so it never changes the catalog version.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "implicitIndex": {
              "description": "A search with no index constraint: it runs against the user's default indexes.",
              "type": "boolean"
            },
            "dynamic": {
              "description": "Uses $tokens$, so some references are only known at run time.",
              "type": "boolean"
            },
            "unresolved": {
              "description": "References to objects not found (or not visible) in the catalog, as type:name.",
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "warnings": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "usage": {
          "description": "How people and the scheduler use the object, from _audit and _internal. Derived; never changes the catalog version.",
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "runs": {
              "type": "integer"
            },
            "users": {
              "type": "integer"
            },
            "views": {
              "type": "integer"
            },
            "viewers": {
              "type": "integer"
            },
            "searches": {
              "type": "integer"
            },
            "adhocSearches": {
              "type": "integer"
            },
            "panelSearchRuns": {
              "type": "integer"
            },
            "lastUsed": {
              "type": "string"
            },
            "runtimeSecs": {
              "type": [
                "number",
                "null"
              ]
            },
            "scheduler": {
              "type": "object",
              "additionalProperties": true
            },
            "unused": {
              "type": "boolean"
            },
            "reason": {
              "type": "string"
            },
            "builtin": {
              "type": "boolean"
            }
          }
        },
        "health": {
          "description": "Health checks evaluated when the bundle was built. Derived.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "checks"
          ],
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "ok",
                "warning",
                "critical"
              ]
            },
            "checks": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "check",
                  "status",
                  "message"
                ],
                "properties": {
                  "check": {
                    "type": "string"
                  },
                  "status": {
                    "type": "string",
                    "enum": [
                      "ok",
                      "warning",
                      "critical"
                    ]
                  },
                  "message": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "permissions": {
          "description": "Splunk object permissions: roles that may read / write it ('*' = every role).",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "read": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "write": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "governance": {
          "description": "Derived governance facts: effective classifications with provenance, and who can reach sensitive data.",
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "EdgeType": {
      "type": "string",
      "enum": [
        "reads",
        "writes",
        "contains",
        "uses",
        "feeds",
        "deploys",
        "triggers",
        "accelerates",
        "mapsTo",
        "grantsAccess",
        "memberOf",
        "inherits"
      ],
      "description": "Direction conventions: app contains object; sourcetype/host/source/input feeds index; role grantsAccess index; user memberOf role; role inherits importedRole; object uses dependency (transform, lookup file, KV collection, field alias...)."
    },
    "Edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "to",
        "type"
      ],
      "properties": {
        "from": {
          "type": "string"
        },
        "to": {
          "type": "string"
        },
        "type": {
          "$ref": "#/$defs/EdgeType"
        },
        "origin": {
          "description": "How the edge was derived.",
          "type": "string",
          "enum": [
            "config",
            "spl",
            "connector",
            "annotation"
          ]
        }
      }
    },
    "ConnectorReport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "connector",
        "status"
      ],
      "properties": {
        "connector": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "ok",
            "partial",
            "skipped",
            "failed"
          ]
        },
        "message": {
          "type": "string"
        },
        "counts": {
          "type": "object",
          "additionalProperties": {
            "type": "integer"
          }
        },
        "instance": {
          "description": "Instance the report is about (set when bundles are merged).",
          "type": "string"
        }
      }
    },
    "ChangeSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "previousGeneratedAt",
        "added",
        "removed",
        "modified"
      ],
      "properties": {
        "previousGeneratedAt": {
          "type": "string",
          "format": "date-time"
        },
        "added": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "removed": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RemovedEntity"
          }
        },
        "modified": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "RemovedEntity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "name"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "$ref": "#/$defs/EntityType"
        },
        "name": {
          "type": "string"
        }
      }
    },
    "Shard": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "kind",
        "count",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "entities",
            "edges"
          ]
        },
        "entityType": {
          "$ref": "#/$defs/EntityType"
        },
        "count": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "Link": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://"
        }
      }
    },
    "Annotations": {
      "description": "Human-curated metadata merged from annotations/*.yaml. Never comes from Splunk.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string"
        },
        "owners": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "classifications": {
          "description": "e.g. PII.Email, Confidential, MITRE.T1078",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "glossaryTerms": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "links": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Link"
          }
        },
        "sources": {
          "description": "Annotation files (and entry numbers) that contributed, e.g. annotations/web.yaml#2",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "primarySource": {
          "description": "The entry that targets this entity by id (the one to edit), if any.",
          "type": "string"
        },
        "domain": {
          "type": "string"
        },
        "dataProducts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "GlossaryTerm": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "term"
      ],
      "properties": {
        "term": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "synonyms": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "related": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "source": {
          "type": "string"
        }
      }
    },
    "AnnotationSource": {
      "description": "Where annotations live, so the web app can link to 'suggest an edit'.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repoUrl",
        "branch",
        "path"
      ],
      "properties": {
        "repoUrl": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://"
        },
        "branch": {
          "type": "string"
        },
        "path": {
          "type": "string"
        }
      }
    },
    "Classification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "sensitive": {
          "type": "boolean"
        },
        "propagate": {
          "type": "boolean"
        },
        "source": {
          "type": "string"
        }
      }
    },
    "OpenReference": {
      "description": "A reference another instance may satisfy; re-resolved by `delvecat-ingest merge`.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "known",
        "edgeType",
        "target"
      ],
      "properties": {
        "known": {
          "type": "string"
        },
        "edgeType": {
          "$ref": "#/$defs/EdgeType"
        },
        "target": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "name"
          ],
          "properties": {
            "type": {
              "$ref": "#/$defs/EntityType"
            },
            "name": {
              "type": "string"
            },
            "app": {
              "type": "string"
            },
            "pattern": {
              "type": "boolean"
            }
          }
        },
        "knownIsFrom": {
          "type": "boolean"
        },
        "origin": {
          "type": "string",
          "enum": [
            "config",
            "spl",
            "connector",
            "annotation"
          ]
        }
      }
    },
    "Domain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "owners": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "parent": {
          "type": "string"
        },
        "links": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Link"
          }
        },
        "source": {
          "type": "string"
        }
      }
    },
    "DataProduct": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "assets"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "domain": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "owners": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "links": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Link"
          }
        },
        "assets": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Entity ids."
        },
        "source": {
          "type": "string"
        }
      }
    }
  }
}
